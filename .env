DATABASE_URL=duckdb:///./data/pfi.db
SECRET_KEY=cyberfit-secret-key-change-in-production

# --- Admin Seeding ---
# Admin already exists in pfi.db — seed endpoint disabled.
# Set to true again only to add a second admin on a fresh database.
ALLOW_ADMIN_SEED=false

DEFAULT_ADMIN_EMAIL=admin@cyberfit.local
DEFAULT_ADMIN_PASSWORD=CyberFit2024!

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
CORS_ORIGINS=*

# --- Runtime ---
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
