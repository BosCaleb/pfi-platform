DATABASE_URL=duckdb:///./data/pfi.db
SECRET_KEY=cyberfit-secret-key-change-in-production

# --- Admin Seeding ---
# true = create or reset the DEFAULT_ADMIN_* account on every startup.
# Disable after initial setup / once you've changed the password in-app.
ALLOW_ADMIN_SEED=true

DEFAULT_ADMIN_EMAIL=admin@cyberfit.local
DEFAULT_ADMIN_PASSWORD=CyberFit2024!

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
CORS_ORIGINS=*

# --- Runtime ---
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
