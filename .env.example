# =============================================================
# CyberFit Backend — Environment Configuration Template
# =============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# =============================================================

# --- Database ---
# DuckDB local path (relative to project root)
DATABASE_URL=duckdb:///./data/pfi.db

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_strong_random_secret_key

# JWT token expiry in minutes (default: 480 = 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Admin Seeding ---
# Set to true ONLY during initial setup. Disable immediately after first login.
ALLOW_ADMIN_SEED=false

# Default admin credentials used when ALLOW_ADMIN_SEED=true
# Change these before enabling seeding in any environment.
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_strong_password

# --- CORS ---
# Comma-separated list of allowed frontend origins.
# Use * only in local development — never in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Runtime ---
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
